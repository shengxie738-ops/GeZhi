# RAGFlow API 配置
RAGFLOW_API_KEY=***REMOVED***
RAGFLOW_BASE_URL=http://127.0.0.1:9380/api/v1
# 智能体 ID（Agent Canvas）
RAGFLOW_AGENT_ID=509fd56a686a11f1b50ebbcdc49c7e63
# 对话助手 ID（Chat Assistant，绑定了数据结构知识库）
RAGFLOW_CHAT_ID=035ac2dc61bd11f1bc4d65770ad0847c
# 数据集 ID（Dataset，直接检索用，绕过RAGFlow内部LLM）
RAGFLOW_DATASET_ID=c35059587aea11f188edd35b1ddc9e71
# 公共知识库 ID 列表（逗号分隔）：对话时自动检索这些库 + 用户私有库
RAGFLOW_PUBLIC_DATASET_IDS=85c6dac47b4111f19a37535bf0d2fe87,13683a007b3611f19887d9da1c29fbd4,c35059587aea11f188edd35b1ddc9e71
# 课程知识库配置（JSON 格式：名称与 dataset_id 对应，供前端渲染选择器）
RAGFLOW_COURSE_DATASETS=[{"name":"人工智能科目","id":"85c6dac47b4111f19a37535bf0d2fe87"},{"name":"计算机程序设计","id":"13683a007b3611f19887d9da1c29fbd4"},{"name":"数据结构","id":"c35059587aea11f188edd35b1ddc9e71"}]

# 大模型 API 配置（已切换为阿里云 Qwen API 中转配置）
OPENAI_API_KEY=YOUR_ALIYUN_QWEN_API_KEY_HERE
OPENAI_API_BASE=https://ws-ormgvfkztc6f2p76.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max
LLM_MODEL_MAX=qwen3.7-max
LLM_MODEL_FLASH=qwen3.6-flash

# 本地数据库配置 (多用户映射与扩展功能)
# Qwen-Image generation. When disabled or missing a key, backend returns SVG fallback.
# Qwen-Image: optional decorative background only (SVG renders readable Chinese text)
QWEN_IMAGE_ENABLED=false
QWEN_IMAGE_API_KEY=YOUR_ALIYUN_QWEN_IMAGE_API_KEY_HERE
# Recommended: use your Model Studio workspace domain, for example https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_IMAGE_ENDPOINT=/api/v1/services/aigc/multimodal-generation/generation
QWEN_IMAGE_MODEL=qwen-image-2.0-pro
QWEN_IMAGE_SIZE=1472*1104
QWEN_IMAGE_TIMEOUT_SECONDS=30
QWEN_IMAGE_PROMPT_EXTEND=false
QWEN_IMAGE_WATERMARK=false

# SMS verification. Keep mock enabled for local development.
SMS_MOCK_ENABLED=true
SMS_CODE_EXPIRE_MINUTES=5
SMS_SEND_COOLDOWN_SECONDS=60
SMS_MAX_VERIFY_ATTEMPTS=5
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_ACCESS_KEY_ID=YOUR_ALIYUN_SMS_ACCESS_KEY_ID
ALIYUN_SMS_ACCESS_KEY_SECRET=YOUR_ALIYUN_SMS_ACCESS_KEY_SECRET
ALIYUN_SMS_SIGN_NAME=YOUR_ALIYUN_SMS_SIGN_NAME
ALIYUN_SMS_TEMPLATE_CODE=YOUR_ALIYUN_SMS_TEMPLATE_CODE

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=Software_Cup

# Backend CORS. Local static frontend uses 5174; Vite/login uses 5173.
# On a server, replace this with your public frontend/API/Gitea origins.
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:3000","http://127.0.0.1:3000"]

# Gitea 真实部署集成配置
GITEA_ENABLED=false
GITEA_BASE_URL=http://127.0.0.1:3000
GITEA_PUBLIC_BASE_URL=https://gezhisystem.com/gitea
GITEA_SSH_DOMAIN=gezhisystem.com
GITEA_SSH_PORT=2222
GITEA_SSH_USER=git
GITEA_API_TOKEN=your_gitea_api_token_here
GITEA_ORG=campus
GITEA_DEFAULT_PRIVATE=true
# 宿主机后端的回调地址。若 Gitea 在 Docker 容器中运行，需配置为 http://host.docker.internal:<backend-port> 以保证跨网访问。
GITEA_PUBLIC_BACKEND_URL=https://gezhisystem.com
GITEA_WEBHOOK_SECRET=replace_with_a_strong_webhook_secret
GITEA_SYNC_MAX_BRANCHES=20
