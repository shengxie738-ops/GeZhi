# =============================================================================
# 格至多智能体协同教育系统 - 环境变量配置模板
# =============================================================================
# 团队协作流程：
#   1. 克隆仓库后执行: copy .env.example .env  (Linux/macOS 用 cp)
#   2. 在 .env 中填入真实密钥（真实值请通过团队密码管理器/私信分发，切勿提交 Git）
#   3. 本地开发可开启 Mock 模式，跳过外部云服务（见下方各开关）
# =============================================================================

# ---- ① RAGFlow 知识库配置 ----
# 部署 RAGFlow 后在管理后台 http://127.0.0.1:9380 创建 API Key 与知识库获取
RAGFLOW_API_KEY=YOUR_RAGFLOW_API_KEY_HERE
RAGFLOW_BASE_URL=http://127.0.0.1:9380/api/v1
# 智能体 ID（Agent Canvas）
RAGFLOW_AGENT_ID=YOUR_RAGFLOW_AGENT_ID_HERE
# 对话助手 ID（Chat Assistant，绑定了数据结构知识库）
RAGFLOW_CHAT_ID=YOUR_RAGFLOW_CHAT_ID_HERE
# 数据集 ID（Dataset，直接检索用，绕过RAGFlow内部LLM）
RAGFLOW_DATASET_ID=YOUR_RAGFLOW_DATASET_ID_HERE
# 公共知识库 ID 列表（逗号分隔）：对话时自动检索这些库 + 用户私有库
RAGFLOW_PUBLIC_DATASET_IDS=YOUR_PUBLIC_DATASET_ID_1,YOUR_PUBLIC_DATASET_ID_2,YOUR_PUBLIC_DATASET_ID_3
# 课程知识库配置（JSON 格式：名称与 dataset_id 对应，供前端渲染选择器）
RAGFLOW_COURSE_DATASETS=[{"name":"人工智能科目","id":"YOUR_AI_DATASET_ID"},{"name":"计算机程序设计","id":"YOUR_CP_DATASET_ID"},{"name":"数据结构","id":"YOUR_DS_DATASET_ID"}]

# ---- ② 大模型 API 配置（阿里云 Qwen，OpenAI 兼容协议） ----
# 团队成员各自申请阿里云百炼 API Key: https://bailian.console.aliyun.com
OPENAI_API_KEY=YOUR_ALIYUN_QWEN_API_KEY_HERE
OPENAI_API_BASE=https://ws-ormgvfkztc6f2p76.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max
LLM_MODEL_MAX=qwen3.7-max
LLM_MODEL_FLASH=qwen3.6-flash
# 全模态语音模型（qwen omni，外语口语训练专用）；留空则复用上面的 OPENAI_API_KEY
QWEN_OMNI_API_KEY=

# ---- 阿里云 DashScope 语音识别（paraformer ASR / Qwen-Audio）----
# 与百炼同体系的 DashScope Key；留空则语音识别相关能力不可用
DASHSCOPE_API_KEY=

# ---- 学术论文真实检索（OpenAlex / Crossref / arXiv） ----
# OpenAlex Key 可提升配额；生产环境建议申请并填写
OPENALEX_API_KEY=
# Crossref 礼貌池联系邮箱；生产环境请填写真实、可联系的团队邮箱
CROSSREF_MAILTO=
ACADEMIC_CACHE_TTL_SECONDS=600
ACADEMIC_HTTP_TIMEOUT_SECONDS=12
ARXIV_CACHE_TTL_SECONDS=86400
ARXIV_MIN_INTERVAL_SECONDS=3
# arXiv 官方接口偶有高延迟，单独使用更长超时
ARXIV_HTTP_TIMEOUT_SECONDS=20

# ---- 教师端 AI 备课（智谱 GLM，必填真实 Key 才能总结或生成教案） ----
AI_LESSON_PREP_API_KEY=YOUR_ZHIPU_GLM_API_KEY_HERE
# 模型广场（model_registry）使用的智谱 Key；留空则回落到上面的 AI_LESSON_PREP_API_KEY
ZHIPU_MODEL_API_KEY=YOUR_ZHIPU_GLM_API_KEY_HERE
AI_LESSON_PREP_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
AI_LESSON_PREP_MODEL=glm-4.5-air
AI_LESSON_PREP_MAX_INPUT_TOKENS=81920
AI_LESSON_PREP_MAX_OUTPUT_TOKENS=49152
AI_LESSON_PREP_TIMEOUT_SECONDS=90

# ---- ③ Qwen-Image 图像生成（可选，关闭走 SVG 兜底） ----
QWEN_IMAGE_ENABLED=false
QWEN_IMAGE_API_KEY=YOUR_ALIYUN_QWEN_IMAGE_API_KEY_HERE
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_IMAGE_ENDPOINT=/api/v1/services/aigc/multimodal-generation/generation
QWEN_IMAGE_MODEL=qwen-image-2.0-pro
QWEN_IMAGE_SIZE=1472*1104
QWEN_IMAGE_TIMEOUT_SECONDS=30
QWEN_IMAGE_PROMPT_EXTEND=false
QWEN_IMAGE_WATERMARK=false

# ---- ④ SMS 短信验证码（本地开发建议开启 Mock） ----
SMS_MOCK_ENABLED=true
SMS_CODE_EXPIRE_MINUTES=5
SMS_SEND_COOLDOWN_SECONDS=60
SMS_MAX_VERIFY_ATTEMPTS=5
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_ACCESS_KEY_ID=YOUR_ALIYUN_SMS_ACCESS_KEY_ID
ALIYUN_SMS_ACCESS_KEY_SECRET=YOUR_ALIYUN_SMS_ACCESS_KEY_SECRET
ALIYUN_SMS_SIGN_NAME=YOUR_ALIYUN_SMS_SIGN_NAME
ALIYUN_SMS_TEMPLATE_CODE=YOUR_ALIYUN_SMS_TEMPLATE_CODE

# ---- ⑤ MySQL 数据库配置 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=Software_Cup

# ---- ⑥ CORS 跨域配置 ----
# 本地开发：5173(Vite登录页) + 5174(Vue3主端) + 3000(Gitea)
# 生产环境：替换为你的公网域名
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:3000","http://127.0.0.1:3000"]

# ---- ⑦ Gitea 代码托管配置 ----
# GITEA_ENABLED=false 时走 Mock 模式，无需真实 Gitea 即可开发
GITEA_ENABLED=false
GITEA_BASE_URL=http://127.0.0.1:3000
GITEA_PUBLIC_BASE_URL=https://gezhisystem.com/gitea
GITEA_SSH_DOMAIN=gezhisystem.com
GITEA_SSH_PORT=2222
GITEA_SSH_USER=git
GITEA_API_TOKEN=your_gitea_api_token_here
GITEA_ORG=campus
GITEA_DEFAULT_PRIVATE=true
# 宿主机后端的回调地址。若 Gitea 在 Docker 容器中运行，需配置为 http://host.docker.internal:<backend-port>
GITEA_PUBLIC_BACKEND_URL=https://gezhisystem.com
GITEA_WEBHOOK_SECRET=replace_with_a_strong_webhook_secret
GITEA_SYNC_MAX_BRANCHES=20

# ---- 论坛管理授权（部署者显式配置，默认无管理者） ----
# 使用已存在的规范 username；全局 teacher 角色不会自动获得论坛管理权
FORUM_MODERATOR_IDS=[]

# ---- Analytics first-saved inventory timestamp convention (operator only) ----
# Operators must independently establish one consistent historical storage-time
# convention for all records covered by this setting before setting it.
# Leave empty when that convention is unknown or mixed. Current host timezone or
# current MySQL session timezone does not establish historical consistency.
# Accepted declarations: UTC, +HH:MM, -HH:MM (00:00 through 14:00 inclusive;
# two digits each, minutes 00-59, hour 14 permits minute 00 only).
# Examples: UTC, +08:00, -05:30. IANA/DST zones and UTC+8 are unsupported.
# A fixed offset cannot reconstruct DST or historical timezone changes.
# Configuration does not certify imported/demo records or authentic learner events.
# After an independently authorized operator change, use the normal service
# configuration reload/restart process. This tranche changes no live settings.
ANALYTICS_RECORDED_TIMEZONE=

# Teaching B1: explicit verified schema and stable institution ID required before activation.
# Dependency chain: revisions => feedback => assignments => teaching.
# B1 installs no assignments/feedback/revisions structure; leave all flags off.
TEACHING_ENABLED=false
TEACHING_ASSIGNMENTS_ENABLED=false
TEACHING_FEEDBACK_ENABLED=false
TEACHING_REVISIONS_ENABLED=false
TEACHING_INSTITUTION_ID=
# Source-teacher keyed operator configuration; never a client-managed role ceiling.
TEACHING_TRUSTED_DELEGATIONS={}
